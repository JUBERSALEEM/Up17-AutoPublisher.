# Public browser configuration (safe to expose).
UP17_APP_MODE=DEMO
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key
# Exact canonical origin used for auth and final app redirects. No path/query/hash.
UP17_SITE_URL=https://your-app.example.com
# Public Supabase Edge Function base that accepts external provider callbacks.
# Keep the main Vercel application protected; no provider secret belongs here.
UP17_OAUTH_CALLBACK_BASE_URL=https://your-project.supabase.co/functions/v1/up17-oauth-callback

# Server-only Supabase token broker. Never prefix with NEXT_PUBLIC_.
# Use a Supabase secret/service key; a publishable key is rejected by the broker.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-key

# Server-only AES-256-GCM token custody keyring.
# Generate each key with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Store only in the deployment secret manager. Keep old keys until all envelopes are rotated.
UP17_TOKEN_ACTIVE_KEY_ID=primary
UP17_TOKEN_KEYS={"primary":"your-base64-32-byte-key"}

# Official provider apps. Create these in the provider consoles; never commit real values.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
INSTAGRAM_CLIENT_ID=your-instagram-app-id
INSTAGRAM_CLIENT_SECRET=your-instagram-app-secret
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret

# Vercel Cron bearer secret for /api/cron/connections. Generate a long random value.
CRON_SECRET=your-random-cron-secret
