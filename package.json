{
  "name": "up17-autopublisher",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first creator automation studio foundation; integrations are not connected.",
  "packageManager": "npm@11.21.2",
  "engines": {
    "node": ">=22.22.3 <23",
    "npm": "11.21.2"
  },
  "scripts": {
    "toolchain:check": "node scripts/toolchain.mjs",
    "dev": "node scripts/run-next.mjs dev --hostname 0.0.0.0",
    "build": "node scripts/run-next.mjs build",
    "start": "node scripts/run-next.mjs start --hostname 0.0.0.0",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "pretest:e2e": "node scripts/run-npm.mjs build",
    "test:e2e": "playwright test --grep-invert \"@visual|@dev\"",
    "test:navigation:dev": "playwright test --config playwright.dev.config.ts --grep @navigation",
    "test:security": "node scripts/run-python.mjs -B scripts/check_docs.py && node scripts/run-python.mjs -B -m unittest discover -s scripts -p test_*.py -v && node scripts/run-npm.mjs test:unit -- tests/unit/security",
    "pretest:visual": "node scripts/run-npm.mjs build",
    "test:visual": "playwright test --grep @visual",
    "pretest:clay": "node scripts/run-npm.mjs build",
    "test:clay": "playwright test --grep @clay",
    "pretest:a11y": "node scripts/run-npm.mjs build",
    "test:a11y": "playwright test --grep @a11y",
    "docs:check": "node scripts/run-python.mjs -B scripts/check_docs.py",
    "check": "node scripts/run-quality.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
