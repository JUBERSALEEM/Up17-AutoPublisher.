name: Local quality gates
on:
  push:
    branches: [arena/698e4880-up17-autopublisher]
  pull_request:
permissions:
  contents: read
jobs:
  quality:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version-file: .nvmrc
          cache: npm
      - run: npm install --global npm@11.21.2
      - run: npm run toolchain:check
      - run: npm ci
      - run: npm run check
      - run: npx playwright install --with-deps chromium
      - run: npm run test:navigation:dev
      - run: npm run test:e2e
      - run: npm run test:visual
      # test:integration deliberately fails while the suite is empty; add real
      # local adapter tests and include that gate at the approved milestone.
      # No deployment, provider credentials or live integration calls.
